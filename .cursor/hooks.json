{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 bstack/shared/router/hook.py --host cursor",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 bstack/shared/router/hook.py --host cursor",
        "timeout": 5
      }
    ],
    "preCompact": [
      {
        "command": "python3 bstack/shared/router/hook.py --host cursor",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "python3 bstack/shared/router/hook.py --host cursor",
        "timeout": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "python3 bstack/shared/router/hook.py --host cursor",
        "timeout": 5
      }
    ]
  }
}
